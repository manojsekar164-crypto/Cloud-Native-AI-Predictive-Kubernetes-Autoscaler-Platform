# Backend Environment Configuration
PORT=4000
HOST=0.0.0.0

# MongoDB Connection URI (Railway MongoDB or verified Atlas connection)
# Example Railway reference: ${{MongoDB.MONGO_URL}} or mongodb://user:pass@host:port/dbname
MONGODB_URI=mongodb://localhost:27017/autoscaler

# ML Prediction Service URL (Railway private networking or public URL)
# Example Railway private network: http://ml-service.railway.internal:5000
ML_SERVICE_URL=http://localhost:5000

# Frontend URL for CORS configuration (e.g., https://your-project.vercel.app)
FRONTEND_URL=http://localhost:3000
